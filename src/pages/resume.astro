---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
	{
		company: 'simpliHŌM',
		title: 'Growth Partner, Nevada Expansion',
		dates: 'December 2024 – Present',
		bullets: [
			'Serve as a strategic growth partner for simpliHŌM’s Nevada expansion, advising a portfolio of 172 independent agent-partners on revenue strategy and operational growth',
			'Apply documented onboarding and support systems, refined across three prior organizations, to help partners scale without depending on constant one-on-one guidance',
		],
	},
	{
		company: 'Epique Realty',
		title: 'Director of Operations & Team Growth, Martinez Group',
		dates: 'March 2023 – December 2024',
		bullets: [
			'Led operations and growth strategy for a 137-partner organization, building the documentation and onboarding workflows that let the business scale beyond what one-on-one conversations could support',
			'Built an interactive, self-service onboarding platform (GoHighLevel) that replaced repeated one-on-one explanations with a documented system partners could use on their own',
			'Elected Co-Chair of Epique Realty’s Agent Advisory Council, representing field-level operational concerns directly to company leadership',
		],
	},
	{
		company: 'eXp Realty',
		title: 'Real Estate Agent / Growth Leader',
		dates: 'November 2017 – March 2023',
		bullets: [
			'Built and led a 606-partner organization by designing documented recruiting and onboarding systems rather than scaling through repeated one-on-one conversations alone',
			'Applied early AI and video tools to convert recurring recruiting conversations into reusable, scalable content, an early version of the documentation-driven approach used across every organization since',
		],
	},
	{
		company: 'AgencyOne Real Estate (formerly Bid 4 Agents and The Force Realty)',
		title: 'Realtor',
		dates: '2005 – November 2017',
		bullets: [
			'Closed 113 real estate transactions over twelve years, developing the negotiation and consultative skills required to translate complex, high-stakes decisions into clear action for clients',
			'Began coaching and mentoring other agents as the practice grew, building the earliest version of the recruiting and operational systems later expanded at eXp Realty, Epique Realty, and simpliHŌM',
		],
	},
	{
		company: 'Luxury Hospitality',
		title: 'Food Server / Concierge',
		dates: '2005 – 2014 (concurrent with real estate career from 2005 onward)',
		bullets: [
			'Four Seasons Hotel Las Vegas, Food Server (2005–2009)',
			'Banquet server, Hyatt / Westin / Marriott (Bellevue, WA), provided stable income while building an independent real estate practice (from 2009)',
			'ARIA Resort & Casino, Concierge / Convention Concierge (2012–2014)',
			'As Convention Concierge, served as the point of contact for convention attendees and group business, coordinating requests across hotel departments and building rapport with event organizers and repeat guests to deliver a consistent, high-touch experience',
		],
	},
];

const projects = [
	{
		company: 'brandondevere.com',
		title: 'Designer & Builder',
		dates: '2026 – Present',
		bullets: [
			'Designed and built end to end: architecture, design system, and content strategy, documented before any code was written, a direct application of the same documentation-first method used in client-facing work',
		],
	},
	{
		company: 'Learn For 2.0',
		title: 'Creator & Host',
		dates: 'July 2019 – Present (editorial process and AI workflow fully redesigned June 2026)',
		bullets: [
			'Interview business owners to surface expertise and lessons that exist only in their own experience, then structure that material into stories and documentation others can use, story discovery applied as a consulting methodology rather than a content exercise',
			'Redesigned the production process into a documented, AI-assisted system, reducing dependence on ad hoc decisions and creating a repeatable editorial standard',
		],
	},
];

const skills = [
	'Business Systems Consulting',
	'Operations & Process Improvement',
	'Documentation & Knowledge Management',
	'Business Development & Partner Success',
	'Scalable Systems Design',
	'Hospitality & Customer Experience',
	'Recruiting & Team Growth',
	'AI Workflow Design',
	'Story Discovery & Consulting Communication',
];
---

<BaseLayout title="Resume" description="Brandon DeVere is a Business Systems Consultant who turns knowledge trapped in one person into documented systems that let businesses grow without them.">
	<section class="container section resume">
		<header class="resume-header">
			<h1>Brandon DeVere</h1>
			<p class="headline">Business Systems Consultant | Operations, Documentation &amp; Scalable Growth</p>
			<ul class="contact">
				<li>Las Vegas, NV</li>
				<li><a href="tel:+17022373166">702-237-3166</a></li>
				<li><a href="mailto:brandon@brandondevere.com">brandon@brandondevere.com</a></li>
				<li><a href="https://www.linkedin.com/in/brandondevere/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
			</ul>
			<div class="downloads">
				<a class="download" href="/brandon-devere-resume.pdf" download>Download PDF</a>
				<a class="download" href="/brandon-devere-resume-ats.txt" download>Download ATS-friendly text</a>
			</div>
		</header>

		<p class="summary">Business Systems Consultant who helps organizations turn knowledge trapped in one person (a founder, a manager, a specialist) into documented, scalable systems that let growth continue without them. Twenty years applying that method across hospitality, real estate, recruiting leadership, and AI-assisted documentation, including building the onboarding infrastructure behind three organizations that scaled to a combined 915 people. The tools change. The underlying discipline (finding what's repeatable, documenting it, and building the system that replaces the repetition) doesn't.</p>

		<h2>Professional Experience</h2>
		{experience.map((job) => (
			<article class="job">
				<div class="job-heading">
					<h3>{job.company}, {job.title}</h3>
					<p class="meta">{job.dates}</p>
				</div>
				<ul>
					{job.bullets.map((bullet) => <li>{bullet}</li>)}
				</ul>
			</article>
		))}

		<h2>Independent Projects</h2>
		{projects.map((job) => (
			<article class="job">
				<div class="job-heading">
					<h3>{job.company}, {job.title}</h3>
					<p class="meta">{job.dates}</p>
				</div>
				<ul>
					{job.bullets.map((bullet) => <li>{bullet}</li>)}
				</ul>
			</article>
		))}

		<h2>Skills</h2>
		<p>{skills.join(' · ')}</p>

		<h2>Education &amp; Certifications</h2>
		<p>Coursework: Highline Community College, Bellevue College, College of Southern Nevada</p>
		<p>Certifications: Nevada Real Estate License · Military Relocation Professional (MRP)</p>
	</section>
</BaseLayout>

<style>
	.resume-header {
		margin-bottom: var(--space-lg);
	}

	.resume-header h1 {
		margin-bottom: var(--space-xs);
	}

	.headline {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		letter-spacing: 0.02em;
		color: var(--color-ink-muted);
		margin-bottom: var(--space-sm);
	}

	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0;
		list-style: none;
		margin: 0 0 var(--space-sm);
		padding: 0;
	}

	.contact li:not(:last-child)::after {
		content: '·';
		margin: 0 0.5rem;
		color: var(--color-ink-muted);
	}

	.downloads {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.download {
		display: inline-block;
		border: 1px solid var(--color-border);
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
		text-decoration: none;
		color: var(--color-ink);
	}

	.download:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
		opacity: 1;
	}

	.summary {
		font-size: 1.125rem;
	}

	.job {
		margin-bottom: var(--space-lg);
	}

	.job-heading h3 {
		margin-bottom: 0.125rem;
		font-size: 1.125rem;
	}

	.job-heading .meta {
		margin-bottom: var(--space-sm);
	}

	.job ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	.job li {
		margin-bottom: 0.5rem;
		max-width: var(--measure);
	}
</style>
